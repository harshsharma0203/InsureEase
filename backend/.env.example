# InsureEase Environment Variables Template
SECRET_KEY=replace-with-secure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8 Configuration
DB_ENGINE=mysql
DB_NAME=insureease_db
DB_USER=root
DB_PASSWORD=nIc@1234
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback: set DB_ENGINE=sqlite to use local SQLite database directly
# DB_ENGINE=sqlite

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOW_ALL=True
